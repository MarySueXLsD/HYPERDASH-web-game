package states;

import core.Art;
import core.Audio;
import core.G;
import core.Juice;
import core.Run;
import core.Ui;
import core.VecFont;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;

class TitleState extends BaseState
{
	var ship:FlxSprite;
	var flame:FlxSprite;
	var lines:Array<FlxSprite> = [];
	var t:Float = 0;
	var dash:Float = 1.5;
	var dashX:Float = 0;

	override function build():Void
	{
		Audio.music("title");
		Audio.setTempo(1);
		stars.rate = 0.45;
		stars.stretch = 0.25;
		stars.tint(G.SECTORS[0].tintA, G.SECTORS[0].tintB);
		stars.center(G.W / 2, 440);

		for (i in 0...7)
		{
			var b = Art.beam(3);
			b.color = i % 3 == 0 ? G.ORANGE : G.KRAFT;
			b.alpha = 0.35;
			resetLine(b, true);
			lines.push(b);
			add(b);
		}

		// Logo: heavy stencil with a hard ink shadow, like a decal on a van.
		var shadow = VecFont.sprite("HYPERDASH", 50, G.INK, 0.24, 0, 10);
		var logo = VecFont.sprite("HYPERDASH", 50, G.ORANGE, 0.24, 0, 10);
		Art.center(logo, G.W / 2, 170);
		shadow.setPosition(logo.x + 7, logo.y + 7);
		add(shadow);
		add(logo);
		for (s in [shadow, logo])
		{
			var tx = s.x;
			s.x -= G.W;
			FlxTween.tween(s, {x: tx}, 0.5, {ease: FlxEase.backOut, startDelay: 0.25});
		}
		new FlxTimer().start(0.55, function(_)
		{
			Audio.sfx("slam");
			Juice.shake(0.3);
			sparks.burst(G.W / 2 + 200, 170, G.ORANGE, 20, 400, 0.4, 0.5);
		});

		var tape = Art.label(440, 54, G.KRAFT);
		tape.setPosition(G.W / 2 - 216, 222);
		add(tape);
		var sub = VecFont.sprite("LIGHTSPEED COURIER", 18, G.INK, 0.12, 0, 3);
		sub.setPosition(tape.x + 8 + (tape.width - 7) / 2 - sub.width / 2, tape.y + (tape.height - 7) / 2 - sub.height / 2);
		add(sub);
		Ui.fadeIn(tape, 0.7, 0.3, 20);
		Ui.fadeIn(sub, 0.7, 0.3, 20);
		var tag = Ui.text(0, 290, G.W, "2 minutes or it's free.", 18, 0xFFC9C2DE);
		add(tag);
		Ui.fadeIn(tag, 0.85);

		add(sparks);
		flame = Art.flame();
		add(flame);
		ship = core.Pilots.ship(core.Pilots.get(core.Pilots.current()));
		add(ship);

		var items:Array<Button> = [];
		var y = 528.0;
		var main:Array<Dynamic> = [
			["STORY", true, startStory],
			["ENDLESS", false, startEndless],
			["TRAINING", false, function() go(TrainingState.new)]
		];
		var i = 0;
		for (e in main)
		{
			var b = new Button(G.W / 2 - 180, y, 360, 76, e[0], e[1], e[2], 28);
			add(b);
			items.push(b);
			Ui.fadeIn(b, 0.9 + i * 0.07, 0.4, 60);
			y += 88;
			i++;
		}
		var opt = new Button(G.W / 2 - 184, y + 4, 180, 60, "OPTIONS", false, function() openSubState(Overlay.options(this)), 18);
		var cred = new Button(G.W / 2 + 4, y + 4, 180, 60, "CREDITS", false, credits, 18);
		for (b in [opt, cred])
		{
			add(b);
			items.push(b);
			Ui.fadeIn(b, 1.15, 0.4, 60);
		}
		add(new Nav(items));

		if (G.flag("story"))
		{
			var badge = Ui.stamp("DELIVERED", 22, G.STAMP_GREEN, G.W - 104, 486, true, 6, true);
			add(badge);
		}
	}

	function resetLine(b:FlxSprite, scatter:Bool):Void
	{
		b.scale.x = FlxG.random.float(1.5, 5);
		b.x = scatter ? FlxG.random.float(-200, G.W) : G.W + FlxG.random.float(0, 300);
		b.y = FlxG.random.float(120, 250);
		b.velocity.x = -FlxG.random.float(900, 1600);
	}

	function startStory():Void
	{
		G.run = new Run(STORY);
		Audio.sfx("start");
		go(() -> new CutsceneState("intro"));
	}

	function startEndless():Void
	{
		G.run = new Run(ENDLESS);
		Audio.sfx("start");
		go(RunState.new);
	}

	function credits():Void
	{
		var o:Overlay = null;
		o = new Overlay("Credits", [{label: () -> "DONE", primary: true, action: function(_) o.dismiss()}],
			"Made for SlapJam. Theme: speed.\n\n"
			+ "Character portraits by Batareya, from 500 Fantasy Pixel Art Portraits.\n\n"
			+ "Ships, UI, music and sound are generated by the game as it runs.\n\n"
			+ "Built with HaxeFlixel and OpenFL.");
		openSubState(o);
	}

	override public function update(elapsed:Float):Void
	{
		super.update(elapsed);
		t += elapsed;
		for (b in lines)
			if (b.x + b.width * b.scale.x < -50)
				resetLine(b, false);

		// Every few seconds the ship punches the throttle: a short dash with a stretch.
		dash -= elapsed;
		if (dash <= 0)
		{
			dash = FlxG.random.float(3, 5);
			dashX = 1;
			Audio.sfx("thrust", 0.6);
		}
		dashX = Math.max(0, dashX - elapsed * 1.6);
		var d = dashX * dashX;
		var bob = Math.sin(t * 2.2) * 8;
		var sway = Math.sin(t * 0.9) * 22;
		Art.center(ship, G.W / 2 + sway, 420 + bob - d * 50);
		ship.scale.set(1 - d * 0.15, 1 + d * 0.2);
		flame.x = Art.cx(ship) - flame.width / 2;
		flame.y = ship.y + ship.height - 20;
		var f = (0.85 + Math.random() * 0.3) * (1 + d * 1.5);
		flame.scale.set(f, f * 1.2);
		if (FlxG.random.bool(60))
			sparks.puff(Art.cx(ship) + FlxG.random.float(-6, 6), ship.y + ship.height + 10, G.ORANGE, FlxG.random.float(-20, 20), 380, 0.5, 0.4);
	}
}
